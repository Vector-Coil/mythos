# Example environment variables (copy to .env.local and fill values)

# Database connection URL. Use the format:
# mysql://USER:PASS@HOST:PORT/DBNAME?ssl=true
# When using cloud DBs or requiring SSL, include `?ssl=true` at the end.
DATABASE_URL=

# Secret used to sign JWTs. Keep this secret in production.
SESSION_SECRET=

# Optional: tune MySQL connection pool limits used by serverless functions.
# Default values are set in code when the env var is not present.
# - DB_POOL_LIMIT: global fallback for connectionLimit (integer)
# - DB_CONN_LIMIT: alternate name for the same setting
# Examples:
# DB_POOL_LIMIT=10
# DB_CONN_LIMIT=10

# Optional: node environment
NODE_ENV=development
# Copy to .env.local (DO NOT commit .env.local)
# Example values — replace with your real secrets

# Database (MySQL) connection URL
DATABASE_URL=mysql://DB_USER:DB_PASS@DB_HOST:3306/DB_NAME?ssl=true

# Session secret for signing cookies/JWTs
SESSION_SECRET=replace_with_random_hex

# Optional Farcaster (deferred)
FARCASTER_CLIENT_ID=
FARCASTER_CLIENT_SECRET=
